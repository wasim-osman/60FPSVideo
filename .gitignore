# ---------------------------------------------------------------------------
# Raw frame intermediates. 35 GB of rawvideo dumps, all reproducible by
# re-running the analysis scripts against the source disc. Never commit these.
# ---------------------------------------------------------------------------
work/
*.nv12
*.p010
*.rgb24
*.gray
*.raw
*.h265

# ---------------------------------------------------------------------------
# Rendered video. Large, and every one of them is regenerated by ab_test.py.
# The copies that matter live in ~/Desktop/FNF-60FPS-A-B/.
# ---------------------------------------------------------------------------
out/*.mp4

# ---------------------------------------------------------------------------
# Compiled probe binaries. Build from analysis/probes/*.swift.
# ---------------------------------------------------------------------------
analysis/probes/vtll
analysis/probes/vtllim
analysis/probes/vtof
analysis/probes/vtofdiag
analysis/probes/vtofq
analysis/probes/vtrender
analysis/probes/vthdr
analysis/probes/vtp010
analysis/probes/vt_hdr_encode

# ---------------------------------------------------------------------------
# CoreML conversion artefacts: 200 MB of .mlpackage plus 91 MB of upstream
# weights. Regenerate with analysis/coreml/convert_rife.py.
# ---------------------------------------------------------------------------
analysis/coreml/build/
analysis/coreml/models/
analysis/coreml/Practical-RIFE/

# ---------------------------------------------------------------------------
# Toolchain
# ---------------------------------------------------------------------------
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
DerivedData/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Packaging output
# ---------------------------------------------------------------------------
# 60FPS.app, its icon and the .dmg. All three are products of scripts/bundle.sh and
# scripts/make-icon.py, and the icon is drawn from code rather than checked in as a blob —
# so the only thing worth committing is the recipe.
build/

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
